<Window x:Class="ChatDemo.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:ChatDemo.Wpf.Converters"
        xmlns:vm="clr-namespace:ChatDemo.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="ChatDemo – gRPC Peer-to-Peer Chat"
        Height="700" Width="1050"
        MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">

    <Window.Resources>
        <conv:BoolToVisibilityConverter       x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:IsOwnToAlignmentConverter       x:Key="IsOwnToAlign"/>
        <conv:IsOwnToBubbleBrushConverter     x:Key="IsOwnToBubble"/>
        <conv:IsOwnToForegroundConverter      x:Key="IsOwnToFg"/>
        <conv:UnreadToVisibilityConverter     x:Key="UnreadToVis"/>
        <conv:OnlineToBrushConverter          x:Key="OnlineToBrush"/>
        <conv:DateTimeToShortTimeConverter    x:Key="DateToTime"/>
        <conv:FirstCharConverter               x:Key="FirstChar"/>

        <!-- Contact list item style -->
        <DataTemplate x:Key="ContactTemplate">
            <Border Background="Transparent" Padding="10,8"
                    Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar circle -->
                    <Grid Grid.Column="0">
                        <Ellipse Width="38" Height="38"
                                 Fill="#007AFF"/>
                        <TextBlock Text="{Binding DisplayName, Converter={StaticResource FirstChar}}"
                                   Foreground="White"
                                   FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <!-- Online dot -->
                        <Ellipse Width="11" Height="11"
                                 Fill="{Binding IsOnline, Converter={StaticResource OnlineToBrush}}"
                                 Stroke="White" StrokeThickness="1.5"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"/>
                    </Grid>

                    <!-- Name + last message -->
                    <StackPanel Grid.Column="1" Margin="10,0,6,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontWeight="SemiBold" FontSize="13.5"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding LastMessage}"
                                   FontSize="11.5" Foreground="#888"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Unread badge -->
                    <Border Grid.Column="2"
                            Background="#FF3B30"
                            CornerRadius="9" Padding="5,1"
                            VerticalAlignment="Center"
                            Visibility="{Binding UnreadCount, Converter={StaticResource UnreadToVis}}">
                        <TextBlock Text="{Binding UnreadCount}"
                                   Foreground="White"
                                   FontSize="11" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Message bubble template -->
        <DataTemplate x:Key="MessageTemplate">
            <Grid Margin="8,3"
                  HorizontalAlignment="{Binding IsOwn, Converter={StaticResource IsOwnToAlign}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{Binding IsOwn, Converter={StaticResource IsOwnToBubble}}"
                        CornerRadius="14"
                        Padding="12,8"
                        MaxWidth="440">
                    <TextBlock Text="{Binding Content}"
                               Foreground="{Binding IsOwn, Converter={StaticResource IsOwnToFg}}"
                               FontSize="13.5"
                               TextWrapping="Wrap"/>
                </Border>

                <TextBlock Grid.Row="1"
                           Text="{Binding Timestamp, Converter={StaticResource DateToTime}}"
                           FontSize="10" Foreground="#999"
                           Margin="4,2,4,0"
                           HorizontalAlignment="{Binding IsOwn, Converter={StaticResource IsOwnToAlign}}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- top toolbar -->
            <RowDefinition Height="*"/>      <!-- main area -->
            <RowDefinition Height="22"/>     <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ── Top toolbar ────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#1C1C1E" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App title / identity -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="20" Margin="0,0,6,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="ChatDemo" Foreground="White"
                               FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" – gRPC P2P" Foreground="#888"
                               FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Setup controls (shown when not connected) -->
                <WrapPanel Grid.Column="1" HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsConnected, Converter={StaticResource InvBoolToVis}}">

                    <TextBlock Text="Name:" Foreground="#AAA" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding LocalUserName, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" Height="26" Padding="4,2"
                             Background="#2C2C2E" Foreground="White" BorderBrush="#555"
                             Margin="0,0,10,0"/>

                    <TextBlock Text="Port:" Foreground="#AAA" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding LocalGrpcPort, UpdateSourceTrigger=PropertyChanged}"
                             Width="65" Height="26" Padding="4,2"
                             Background="#2C2C2E" Foreground="White" BorderBrush="#555"
                             Margin="0,0,10,0"/>

                    <TextBlock Text="API:" Foreground="#AAA" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                             Width="170" Height="26" Padding="4,2"
                             Background="#2C2C2E" Foreground="White" BorderBrush="#555"
                             Margin="0,0,10,0"/>

                    <Button Content="Go Online" Height="26" Padding="12,0"
                            Background="#007AFF" Foreground="White" BorderThickness="0"
                            Command="{Binding StartCommand}"
                            Cursor="Hand" FontSize="12"/>
                </WrapPanel>

                <!-- Connected info -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Orientation="Horizontal"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                    <Ellipse Width="9" Height="9" Fill="#34C759" Margin="0,0,6,0"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LocalUserName}" Foreground="White"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LocalGrpcPort, StringFormat=' · :{0}'}"
                               Foreground="#888" FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Connect-to-peer -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Peer:" Foreground="#AAA" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Text="{Binding ConnectAddress, UpdateSourceTrigger=PropertyChanged}"
                             Width="150" Height="26" Padding="4,2"
                             Background="#2C2C2E" Foreground="White" BorderBrush="#555"
                             Margin="0,0,6,0"/>
                    <Button Content="Connect" Height="26" Padding="10,0"
                            Background="#34C759" Foreground="White" BorderThickness="0"
                            Command="{Binding ConnectToPeerCommand}"
                            Cursor="Hand" FontSize="12"
                            Margin="0,0,6,0"/>
                    <Button Content="↻" Height="26" Width="26"
                            Background="#555" Foreground="White" BorderThickness="0"
                            Command="{Binding RefreshContactsCommand}"
                            Cursor="Hand" FontSize="14" ToolTip="Refresh contacts from API"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Main area: contacts + chat ─────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" MaxWidth="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Contact sidebar ──────────────────────────────────────── -->
            <Border Grid.Column="0" Background="#FFFFFF"
                    BorderBrush="#DCDCDC" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F9F9F9" Padding="10,8"
                            BorderBrush="#DCDCDC" BorderThickness="0,0,0,1">
                        <TextBlock Text="Contacts" FontSize="13"
                                   FontWeight="SemiBold" Foreground="#333"/>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Contacts}"
                             SelectedItem="{Binding SelectedContact}"
                             ItemTemplate="{StaticResource ContactTemplate}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <EventSetter Event="MouseLeftButtonUp"
                                             Handler="ContactItem_Click"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E8F0FE"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F5F5F5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ── Chat area ─────────────────────────────────────────────── -->
            <Grid Grid.Column="1" Background="#F0F0F0">
                <!-- Placeholder when no contact selected -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasSelectedContact, Converter={StaticResource InvBoolToVis}}">
                    <TextBlock Text="💬" FontSize="52" HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a contact to start chatting"
                               FontSize="15" Foreground="#888"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="or connect to a peer using the toolbar"
                               FontSize="12" Foreground="#AAA"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Active chat -->
                <Grid Visibility="{Binding HasSelectedContact, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Chat header -->
                    <Border Grid.Row="0" Background="White" Padding="16,10"
                            BorderBrush="#DCDCDC" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Ellipse Width="34" Height="34" Fill="#007AFF" Margin="0,0,10,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedContact.DisplayName}"
                                               FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="11" Foreground="#666">
                                        <Run Text="{Binding SelectedContact.GrpcAddress}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9"
                                         Fill="{Binding SelectedContact.IsOnline,
                                                Converter={StaticResource OnlineToBrush}}"
                                         Margin="0,0,5,0"/>
                                <TextBlock FontSize="11.5" Foreground="#555"
                                           Text="{Binding SelectedContact.IsOnline,
                                                  StringFormat='{}Online'}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Messages list -->
                    <ScrollViewer Grid.Row="1" x:Name="MessagesScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="4,8">
                        <ItemsControl ItemsSource="{Binding Messages}"
                                      ItemTemplate="{StaticResource MessageTemplate}"/>
                    </ScrollViewer>

                    <!-- Input area -->
                    <Border Grid.Row="2" Background="White" Padding="12,8"
                            BorderBrush="#DCDCDC" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding MessageInput, UpdateSourceTrigger=PropertyChanged}"
                                     x:Name="MessageTextBox"
                                     MinHeight="36" MaxHeight="100"
                                     Padding="10,8" FontSize="13.5"
                                     BorderBrush="#DCDCDC" BorderThickness="1"
                                     Background="#FAFAFA"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="False"
                                     VerticalContentAlignment="Center"
                                     KeyDown="MessageBox_KeyDown"
                                     Margin="0,0,8,0"/>

                            <Button Grid.Column="1"
                                    Content="Send"
                                    Width="72" Height="36"
                                    Background="#007AFF" Foreground="White"
                                    BorderThickness="0"
                                    FontSize="13" FontWeight="SemiBold"
                                    Command="{Binding SendMessageCommand}"
                                    Cursor="Hand"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ── Status bar ─────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="#2C2C2E" Padding="8,0">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="#AAA" FontSize="11"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>

